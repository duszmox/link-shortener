// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model ShortLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  url String

  slug String @unique

  blocked Boolean @default(false)

  // Clerk user id of the owner; null for links created while signed out
  userId String?

  // The fields below are optional because links created before accounts
  // existed don't have them, and Prisma can't read a missing required field
  // null means "on"
  trackClicks   Boolean?
  clicks        Int?
  lastClickedAt DateTime?

  @@index([userId])
}
