{
  "name": "link-shortener",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait && prisma db push --skip-generate",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.25",
    "@prisma/client": "6.19.3",
    "altcha": "3.6.0",
    "altcha-lib": "2.8.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
